# 复制为 .env。密钥与数据库密码只放本地，不提交 Git。
APP_ENV=development
# 必填随机值，未设置时应用拒绝启动；可用 python3 -c 'import secrets; print(secrets.token_hex(32))' 生成。
SECRET_KEY=

# Docker 中 web 服务固定连接 db:3306，以下 HOST/PORT 只供 venv 方式使用。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vocab_review
DB_USER=vocab_app
# 首次启动 db 前填写随机密码；数据卷初始化后修改需同步修改 MySQL 账户。
DB_PASSWORD=

# 独立测试库；pytest 的 db 测试会清空该库，名称必须以 _test 结尾。
TEST_DB_NAME=vocab_review_test
TEST_DB_USER=vocab_test
TEST_DB_PASSWORD=

# flask seed-demo-user 创建的演示学习者；密码填随机值，只在本地使用。
DEMO_USERNAME=demo
DEMO_USER_PASSWORD=

# 仅 db 容器初始化使用。
MYSQL_ROOT_PASSWORD=

# web 容器以宿主用户运行；用 id -u / id -g 查看。
HOST_UID=1000
HOST_GID=1000

ML_MODEL_DIR=artifacts/ml
DL_MODEL_DIR=artifacts/dl
